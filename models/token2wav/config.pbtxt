name: "token2wav"
backend: "python"
max_batch_size: 1

dynamic_batching {
  preferred_batch_size: [1]
  max_queue_delay_microseconds: 0
  priority_levels: 100
  default_priority_level: 100
}

parameters [
  {
    key: "model_dir"
    value: { string_value: "/workspace/CosyVoice/runtime/triton_trtllm/Fun-CosyVoice3-0.5B-2512" }
  },
  {
    key: "dynamic_batch_plan"
    value: { string_value: "flow.decoder.estimator.autocast_fp16.dynamic_batch.1.plan" }
  }
]

input [
  {
    name: "target_speech_tokens"
    data_type: TYPE_INT32
    dims: [-1]
  },
  {
    name: "target_speech_tokens_len"
    data_type: TYPE_INT32
    dims: [1]
    optional: true
  },
  {
    name: "prompt_speech_tokens"
    data_type: TYPE_INT32
    dims: [-1]
  },
  {
    name: "prompt_speech_tokens_len"
    data_type: TYPE_INT32
    dims: [1]
    optional: true
  },
  {
    name: "prompt_speech_feat"
    data_type: TYPE_FP16
    dims: [-1, 80]
  },
  {
    name: "prompt_speech_feat_len"
    data_type: TYPE_INT32
    dims: [1]
    optional: true
  },
  {
    name: "prompt_spk_embedding"
    data_type: TYPE_FP16
    dims: [-1]
  },
  {
    name: "token_offset"
    data_type: TYPE_INT32
    dims: [1]
    reshape: { shape: [] }
    optional: true
  },
  {
    name: "finalize"
    data_type: TYPE_BOOL
    dims: [1]
    reshape: { shape: [] }
    optional: true
  }
]

output [
  {
    name: "mel"
    data_type: TYPE_FP32
    dims: [80, -1]
  }
]

instance_group [
  {
    count: 2
    kind: KIND_GPU
    gpus: [0]
  }
]
