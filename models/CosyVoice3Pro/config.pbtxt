name: "CosyVoice3Pro"
backend: "python"
max_batch_size: 1

dynamic_batching {
  max_queue_delay_microseconds: 0
}

model_transaction_policy {
  decoupled: false
}

parameters [
  {
    key: "llm_tokenizer_dir"
    value: {
      string_value: "/workspace/CosyVoice/runtime/triton_trtllm/hf_cosyvoice3_llm"
    }
  },
  {
    key: "model_dir"
    value: {
      string_value: "/workspace/CosyVoice/runtime/triton_trtllm/Fun-CosyVoice3-0.5B-2512"
    }
  },
  {
    key: "speaker_store_dir"
    value: {
      string_value: "/workspace/cosyvoice_speaker_store"
    }
  },
  {
    key: "speaker_cache_max_entries"
    value: {
      string_value: "64"
    }
  },
  {
    key: "eager_cuda_init"
    value: {
      string_value: "false"
    }
  },
  {
    key: "flow_batching_enabled"
    value: {
      string_value: "false"
    }
  },
  {
    key: "vocoder_batching_enabled"
    value: {
      string_value: "false"
    }
  },
  {
    key: "acoustic_token_bucket_size"
    value: {
      string_value: "64"
    }
  },
  {
    key: "acoustic_mel_bucket_size"
    value: {
      string_value: "128"
    }
  }
]

input [
  {
    name: "speaker_id"
    data_type: TYPE_STRING
    dims: [1]
    optional: true
  },
  {
    name: "reference_wav"
    data_type: TYPE_FP32
    dims: [-1]
    optional: true
  },
  {
    name: "reference_wav_len"
    data_type: TYPE_INT32
    dims: [1]
    optional: true
  },
  {
    name: "reference_text"
    data_type: TYPE_STRING
    dims: [1]
    optional: true
  },
  {
    name: "prompt"
    data_type: TYPE_STRING
    dims: [1]
    optional: true
  },
  {
    name: "instruct_text"
    data_type: TYPE_STRING
    dims: [1]
    optional: true
  },
  {
    name: "target_text"
    data_type: TYPE_STRING
    dims: [1]
  }
]

output [
  {
    name: "waveform"
    data_type: TYPE_FP32
    dims: [-1]
  }
]

instance_group [
  {
    count: 10
    kind: KIND_CPU
  }
]
